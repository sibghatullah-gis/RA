# Copy to .env and adjust, or just export these as real env vars before running.
# app.py doesn't load .env automatically — see README for the two ways to set this.

PGHOST=localhost
PGPORT=5432
PGDATABASE=programme_tracker
PGUSER=postgres
PGPASSWORD=postgres

# Alternatively, set this single var and skip the ones above:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/programme_tracker
